Algoritmo PromedioNotas
	Definir nota1, nota2, nota3, nota4, nota5, promedio Como Real
	Escribir 'Escribe la nota 1:'
	Leer nota1
	Escribir 'Escribe la nota 2:'
	Leer nota2
	Escribir 'Escribe la nota 3:'
	Leer nota3
	Escribir 'Escribe la nota 4:'
	Leer nota4
	Escribir 'Escribe la nota 5:'
	Leer nota5
	promedio <- (nota1+nota2+nota3+nota4+nota5)/5
	Escribir 'Tu promedio es: ', promedio
FinAlgoritmo
